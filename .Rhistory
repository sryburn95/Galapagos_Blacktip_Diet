Rarefaction_BT_F <- read.csv("Rarefaction_Gal_BT_Female.csv")
#Switch axis
Rarefaction_BT_F_Reverse <- data.frame(t(Rarefaction_BT_F[-1]))
colnames(Rarefaction_BT_F_Reverse) <- Rarefaction_BT_F[, 1]
sample_data(Rarefaction_BT_F_Reverse)
summary(Rarefaction_BT_F_Reverse)
attach(Rarefaction_BT_F_Reverse)
Rarefaction_BT_F <- read.csv("Rarefaction_Gal_BT_Female.csv")
#Switch axis
Rarefaction_BT_F_Reverse <- data.frame(t(Rarefaction_BT_F[-1]))
colnames(Rarefaction_BT_F_Reverse) <- Rarefaction_BT_F[, 1]
sample_data(Rarefaction_BT_F_Reverse)
summary(Rarefaction_BT_F_Reverse)
attach(Rarefaction_BT_F_Reverse)
names(Rarefaction_BT_F_Reverse)
#ci=2 means that the CI is 95%
sp_BT_F <- specaccum(Rarefaction_BT_F_Reverse, object="prey taxa", permutations = 100, ci=2)
plot(sp_BT_F, ylab="Number of Prey Taxa", xlab="Number of female samples",col="black",ci.type="poly", ci.col="grey", ci.lty = 0,
xlim=c(1, 110), ylim=c(1, 30))
